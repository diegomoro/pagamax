{
  "expo": {
    "name": "Paga Menos",
    "slug": "paga-menos",
    "version": "1.0.4",
    "orientation": "portrait",
    "scheme": "pagamenos",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/icon.png",
      "assets/adaptive-icon.png",
      "assets/splash-icon.png",
      "assets/favicon.png",
      "assets/data/promo-index.bundle.txt",
      "assets/data/default-methods.json"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pagamenos.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f666a"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Paga Menos usa la cámara para escanear códigos QR de comercios."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "backendApiUrl": "https://pagamax-public-beta-backend.vercel.app",
      "privacyUrl": "https://pagamax-public-beta-backend.vercel.app/privacy",
      "termsUrl": "https://pagamax-public-beta-backend.vercel.app/terms",
      "accountDeletionUrl": "https://pagamax-public-beta-backend.vercel.app/delete-account",
      "supportUrl": "https://pagamax-public-beta-backend.vercel.app/support",
      "eas": {
        "projectId": "3ecd4a17-ce58-4809-8a36-dfd5269b0853"
      }
    }
  }
}
