{
  "name": "@pagamax/app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sync-data": "node ../scripts/sync-mobile-data.mjs",
    "build:preview": "npx --yes eas-cli@20.1.0 build --platform android --profile preview",
    "build:production": "npx --yes eas-cli@20.1.0 build --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@pagamax/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.12",
    "expo-asset": "~56.0.17",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-intent-launcher": "~56.0.4",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.0"
